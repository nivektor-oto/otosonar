{
  "manifest_version": 3,
  "name": "OtoSonar — Anlık Araç Analizi",
  "version": "0.1.0",
  "description": "Sahibinden.com ve arabam.com ilanlarını tek tıkla OtoSonar AI ile analiz et.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "OtoSonar ile analiz et",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.sahibinden.com/*",
    "https://*.arabam.com/*",
    "https://otosonar.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.sahibinden.com/ilan/*",
        "https://*.arabam.com/ilan/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}

# ============================================================
# OtoSonar — Environment variables
# ============================================================
# Copy to apps/web/.env.local for local dev, and add to Vercel
# project env for production/preview.

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Session secrets (min 32 chars each) ---
FOUNDER_SESSION_SECRET=""
USER_SESSION_SECRET=""
OAUTH_STATE_SECRET=""            # opsiyonel, yoksa USER_SESSION_SECRET kullanılır
IP_HASH_SALT=""                  # rastgele 32+ karakter, hashlenmiş IP için

# --- Founder login ---
FOUNDER_EMAIL="kurucu@otosonar.com"
FOUNDER_PASSWORD=""

# --- Public site ---
NEXT_PUBLIC_SITE_URL="https://otosonar.com"

# --- AI providers ---
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Web Push (VAPID) ---
# Üretmek için: node apps/web/scripts/generate-vapid.js
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:kurucu@otosonar.com"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Redirect URI: https://otosonar.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Apple Sign In (opsiyonel, Apple Developer hesabı gerekir) ---
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Iyzico (opsiyonel, şirket aktive olunca) ---
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://api.iyzipay.com"

# --- Email (opsiyonel, Resend bağlandığında) ---
RESEND_API_KEY=""
EMAIL_FROM="OtoSonar <no-reply@otosonar.com>"

# --- Cron secret ---
# Vercel Cron isteklerinde Authorization: Bearer $CRON_SECRET bekleriz
CRON_SECRET=""

# OtoSonar Web — environment variable template
# Bu dosya repo'ya commit edilir. GERÇEK değerleri .env.local içine yaz (committed değil).

# ====================================================================
# AI PROVIDERS
# ====================================================================

# Gemini 2.5 Flash (primary AI motor — ücretsiz tier yeterli MVP için)
# Al: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude Haiku 4.5 (fallback — opsiyonel ama tavsiye edilir)
# Al: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ====================================================================
# DATABASE (Neon / Supabase / herhangi bir Postgres)
# ====================================================================

# Connection string format:
# postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Direct connection for migrations (Neon pooler kullanıyorsan)
DIRECT_URL=

# ====================================================================
# PUBLIC CONFIG
# ====================================================================

# Production URL (otosonar.com) — metadata ve OG için
NEXT_PUBLIC_SITE_URL=https://otosonar.com

# ====================================================================
# KURUCU / FOUNDER (yönetici paneli girişi)
# ====================================================================

FOUNDER_EMAIL=kurucu@otosonar.com
FOUNDER_PASSWORD=
# openssl rand -hex 32  ile üret
FOUNDER_SESSION_SECRET=

# ====================================================================
# ÖDEME (Production'da gerekli, MVP local'de opsiyonel)
# ====================================================================

# İyzico (lansman sonrası eklenecek)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ====================================================================
# EMAIL (Resend — production'da gerekli)
# ====================================================================

RESEND_API_KEY=
EMAIL_FROM=destek@otosonar.com

# ====================================================================
# FILE STORAGE (R2 / S3 — fotoğraflar için)
# ====================================================================

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=otosonar-media
R2_ACCOUNT_ID=

# ====================================================================
# MONITORING (opsiyonel)
# ====================================================================

SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ====================================================================
# FEATURE FLAGS (server-only, fail-closed; bkz. lib/feature-flags.ts)
# Hepsi default `false` — boş bırakırsan kapalı kalır. Açmak için "true".
# ====================================================================

# Marketplace ücretli listing modu (paywall logic ileride bağlanacak)
MARKETPLACE_PAYWALL_ENABLED=false

# Buyer ↔ Seller in-app messaging (POST /api/conversations*)
MESSAGING_ENABLED=false

# Meta WhatsApp Cloud API webhook (POST /api/wa/webhook)
WHATSAPP_WEBHOOK_ENABLED=false

# Dealer CRM API key oluşturma/silme (POST/DELETE /api/dealer/api-keys*)
CRM_API_ENABLED=false

# Dealer envanter yönetimi (POST/PATCH/DELETE /api/dealer/vehicles*)
DEALER_ADVANCED_FEATURES=false

# AI arıza teşhis (POST /api/diagnose) — Gemini/Claude tüketir
AI_DIAGNOSIS_ENABLED=false

# WA webhook için Meta credentials (flag açık iken zorunlu)
WA_APP_SECRET=
WA_VERIFY_TOKEN=

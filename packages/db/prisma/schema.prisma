// OtoSonar - Prisma Schema
// Faz 1 MVP: User, Listing, Analysis, Subscription temelleri.
// Faz 2'de Marketplace (Bid, Transaction, Commission) eklenecek.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

enum UserType {
  BUYER     // B2C - araç alıcısı
  DEALER    // B2B - galerici
  BROKER    // Komisyoncu
  ADMIN
}

enum DealerVolume {
  SMALL     // <5 araç/ay
  MEDIUM    // 5-20 araç/ay
  LARGE     // 20+ araç/ay
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  customerNumber Int       @unique @default(autoincrement())
  email          String    @unique
  phone          String?   @unique
  fullName       String
  userType       UserType  @default(BUYER)
  passwordHash   String?   // nullable — OAuth ile giriş olabilir
  avatarUrl      String?
  emailVerified  DateTime?
  phoneVerified  DateTime?
  totpSecret     String?   // galericide zorunlu
  totpEnabled    Boolean   @default(false)
  kvkkConsentAt  DateTime?
  marketingOptIn Boolean   @default(false)
  quizResult     Json?     // { persona, recommendedTier, answers, completedAt }
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  dealer        Dealer?
  broker        Broker?
  subscriptions Subscription[]
  analyses      Analysis[]
  buyerPrefs    BuyerPreferences?

  @@index([userType])
  @@index([createdAt])
  @@index([customerNumber])
}

model BuyerPreferences {
  id          String   @id @default(cuid())
  userId      String   @unique
  budgetMin   Int?
  budgetMax   Int?
  brands      String[] // PostgreSQL array
  cities      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dealer {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  taxNo              String?            @unique  // vergi numarası
  mersisNo           String?            @unique
  cityId             String
  address            String?
  monthlyVolume      DealerVolume?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  ibanEncrypted      String?            // app-level AES-256 GCM
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cityId, verificationStatus])
}

model Broker {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?
  city        String
  publicSlug  String   @unique  // profil URL'i için
  commissionRate Decimal @default(0.35)  // satış komisyonundan payı (0.35 = %35)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUBSCRIPTION
// ============================================================

enum Tier {
  PLUS
  PRO
  MAX
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  tier                 Tier
  billingPeriod        BillingPeriod      @default(MONTHLY)
  status               SubscriptionStatus @default(TRIAL)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  paytrSubscriptionRef String?
  iyzicoSubscriptionRef String?
  appleOriginalTxId    String?  // iOS IAP için
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

// ============================================================
// LISTING & ANALYSIS
// ============================================================

enum ListingSource {
  SAHIBINDEN
  ARABAM
  MANUAL
  MARKETPLACE
}

model Listing {
  id              String         @id @default(cuid())
  source          ListingSource
  externalUrl     String?
  externalId      String?        // kaynak platform ilan id
  rawHtmlR2Key    String?        // ham sayfa arşivi (denetim için)
  parsedData      Json           // { brand, model, variant, year, km, price, description, photos, ... }
  title           String?
  brand           String?
  model           String?
  variant         String?
  year            Int?
  km              Int?
  fuelType        String?
  transmission    String?
  city            String?
  askingPrice     Int?
  descriptionText String?        @db.Text
  submittedByUserId String?
  createdAt       DateTime       @default(now())

  analyses Analysis[]

  @@index([brand, model, year])
  @@index([city, askingPrice])
  @@index([createdAt])
  @@unique([source, externalId])
}

model Analysis {
  id                String   @id @default(cuid())
  listingId         String
  userId            String
  emsalValue        Int?     // tahmini pazar değeri (TL)
  emsalConfidence   Decimal? // 0-1 arası
  redFlags          Json     // [{type, severity, detail, repairEstimate}]
  repairEstimateMin Int?     // toplam tahmini tamir (TL)
  repairEstimateMax Int?
  negotiationScore  Int?     // 0-100 pazarlık skoru
  reportMarkdown    String?  @db.Text  // kullanıcıya gösterilen zengin rapor
  aiModelVersion    String   @default("haiku-4.5")
  processingTimeMs  Int?
  createdAt         DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([listingId])
}

// ============================================================
// WAITLIST (launch öncesi)
// ============================================================

enum WaitlistUserType {
  buyer
  dealer
  broker
}

model WaitlistEntry {
  id             String            @id @default(cuid())
  email          String            @unique
  fullName       String?
  userType       WaitlistUserType
  city           String?
  referralSource String?
  queueNumber    Int               @unique @default(autoincrement())
  ipHash         String?
  createdAt      DateTime          @default(now())

  @@index([userType])
  @@index([createdAt])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // "user.login", "subscription.create", "bid.place", ...
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// AUTH TOKENS & SESSIONS
// ============================================================

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
  MAGIC_LINK
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique  // sha256 of raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipHash       String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ============================================================
// RATE LIMIT (durable, Postgres-backed)
// ============================================================

model RateLimitBucket {
  id         String   @id @default(cuid())
  bucketKey  String   @unique  // "ip:1.2.3.4:/api/auth/login"
  hits       Int      @default(1)
  windowEnds DateTime
  createdAt  DateTime @default(now())

  @@index([windowEnds])
}

// ============================================================
// ANALYTICS (self-hosted events)
// ============================================================

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String   // anonymous cookie id
  userId     String?
  event      String   // "pageview", "cta.click", "signup.complete", ...
  path       String?
  referer    String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  country    String?
  device     String?  // "mobile" | "desktop" | "tablet"
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([sessionId])
  @@index([userId, createdAt])
}

// ============================================================
// ERROR LOG (self-hosted sentry-lite)
// ============================================================

enum ErrorLevel {
  INFO
  WARNING
  ERROR
  FATAL
}

model ErrorLog {
  id          String     @id @default(cuid())
  level       ErrorLevel @default(ERROR)
  message     String     @db.Text
  stack       String?    @db.Text
  path        String?
  userId      String?
  sessionId   String?
  userAgent   String?
  fingerprint String     // hash of message+first-stack-frame for grouping
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([fingerprint, createdAt])
  @@index([level, createdAt])
  @@index([createdAt])
}

// ============================================================
// REFERRAL
// ============================================================

model ReferralCode {
  id         String   @id @default(cuid())
  ownerId    String
  code       String   @unique  // shortish "AHMET42"
  usesCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model ReferralRedemption {
  id          String   @id @default(cuid())
  code        String
  referredId  String   @unique  // invited user
  bonusGrantedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([code])
}

// ============================================================
// MARKETPLACE (Faz 2 iskelet)
// ============================================================

enum MarketplaceListingStatus {
  DRAFT
  ACTIVE
  SOLD
  WITHDRAWN
  EXPIRED
}

model MarketplaceListing {
  id            String                   @id @default(cuid())
  sellerId      String                   // User.id (dealer or buyer)
  brand         String
  model         String
  year          Int
  km            Int
  city          String
  askingPrice   Int
  description   String?                  @db.Text
  photosJson    Json?                    // array of urls
  status        MarketplaceListingStatus @default(DRAFT)
  closedAt      DateTime?
  winningBidId  String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  bids          MarketplaceBid[]

  @@index([status, createdAt])
  @@index([brand, model, year])
}

model MarketplaceBid {
  id          String    @id @default(cuid())
  listingId   String
  bidderId    String   // dealer user id
  amount      Int
  note        String?   @db.Text
  retracted   Boolean   @default(false)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([bidderId])
}

// ============================================================
// PUSH NOTIFICATIONS
// ============================================================

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String?
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// PAYMENT (İyzico / PayTR soyut katman)
// ============================================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model PaymentIntent {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amountKurus    Int           // 249_00 = 249.00 TL
  currency       String        @default("TRY")
  provider       String        // "iyzico" | "paytr"
  providerRef    String?       @unique  // idempotency key
  status         PaymentStatus @default(PENDING)
  failReason     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// ============================================================
// OAUTH (Google, Apple, ...)
// ============================================================

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "google" | "apple"
  providerAccountId String   // sub (subject) id from provider
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================
// AI HISTORY (Damage + Plate)
// ============================================================

enum DamageSeverity {
  YOK
  HAFIF
  ORTA
  AGIR
}

model DamageAnalysis {
  id                   String         @id @default(cuid())
  userId               String?        // nullable for anonymous
  sessionId            String?        // anonymous cookie for grouping
  overallSeverity      DamageSeverity
  repairEstimateMinTL  Int
  repairEstimateMaxTL  Int
  damagesJson          Json           // [{type, location, severity, description}]
  notes                String?        @db.Text
  imageHash            String?        // sha256 of image bytes — avoid duplicate stores
  modelVersion         String         @default("gemini-2.5-flash")
  durationMs           Int?
  createdAt            DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model PlateRecognition {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String?
  plate         String?
  confidence    Float
  isTurkish     Boolean
  region        String?
  imageHash     String?
  modelVersion  String   @default("gemini-2.5-flash")
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================
// CREDIT LEDGER (referral bonus, trial credits)
// ============================================================

enum CreditKind {
  REFERRAL_BONUS
  TRIAL_CREDIT
  SUPPORT_GIFT
  MANUAL_ADJUSTMENT
}

model CreditLedger {
  id          String     @id @default(cuid())
  userId      String
  kind        CreditKind
  amountDays  Int        // + = gifted days, - = consumed
  note        String?
  refId       String?    // referral redemption id, payment intent id, etc.
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
}

// ============================================================
// PUSH SEND LOG
// ============================================================

model PushSendLog {
  id           String   @id @default(cuid())
  userId       String?
  endpoint     String?
  title        String
  body         String?  @db.Text
  url          String?
  success      Boolean
  errorCode    Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
